# Wealthfolio Chile — environment template.
#
#   cp .env.example .env   &&   edit .env
#
# `.env` is git-ignored and must stay that way: it holds the key that encrypts
# your data and the hash of your password.

# ── Version ───────────────────────────────────────────────────────────
# Always an explicit tag. Never `latest` — see infra/compose.yml.
# Verified against this project's addon: 3.6.2
#
# The Docker Hub tags carry no `v` prefix even though the git tags do: the
# release `v3.6.2` is published as `wealthfolio/wealthfolio:3.6.2`. Writing
# `v3.6.2` here fails the pull with `manifest unknown`.
WF_VERSION=3.6.2

# ── Network ───────────────────────────────────────────────────────────
# Loopback only by default. Put a reverse proxy with TLS in front before
# changing this to 0.0.0.0.
WF_BIND_ADDR=127.0.0.1
WF_PORT=8088

# Origin the browser will use. Required when auth is enabled.
# WF_CORS_ALLOW_ORIGINS=https://wealthfolio.tudominio.cl

# ── Secrets ───────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
WF_SECRET_KEY=

# Argon2id hash of your password. Generate with:
#   printf 'tu-password' | argon2 unsalt16chars!! -id -e
# Docker Compose interpolates `$`, so wrap the value in SINGLE quotes:
#   WF_AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
WF_AUTH_PASSWORD_HASH=

WF_AUTH_REQUIRED=true
WF_AUTH_TOKEN_TTL_MINUTES=60

# ── Addons ────────────────────────────────────────────────────────────
# Where sideloaded addons live on the host. `scripts/deploy-addon.sh` copies
# the built Wealthfolio Chile bundle here.
WF_ADDONS_DIR=./addons

# ── Misc ──────────────────────────────────────────────────────────────
TZ=America/Santiago
WF_MEMORY_LIMIT=768M
WF_REQUEST_TIMEOUT_MS=30000

# Exposes an MCP endpoint for external AI agents. Off unless you want it.
WF_MCP_ENABLED=false
